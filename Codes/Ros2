def main(args=None):
    rclpy.init(args=args)
    tello = TelloROS()
    
    mission_thread = threading.Thread(target=tello.mission)
    mission_thread.start()
    
    rclpy.spin(tello)
    
    tello.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()


